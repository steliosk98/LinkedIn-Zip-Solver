{
  "manifest_version": 3,
  "name": "LinkedIn ZIP Solver",
  "description": "Record a ZIP path in the popup and replay it on the LinkedIn ZIP game.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_title": "LinkedIn ZIP Solver",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
